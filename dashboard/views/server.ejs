                    { key: 'antiSpam', icon: '📨', name: 'منع السبام' },
                    { key: 'antiLink', icon: '🔗', name: 'منع الروابط' },
                    { key: 'antiBot', icon: '🤖', name: 'منع البوتات' },
                    { key: 'antiSelfbot', icon: '👤', name: 'منع السيلف بوت' },
                    { key: 'antiWebhook', icon: '🪝', name: 'منع الويهوك' },
                    { key: 'antiNickname', icon: '✏️', name: 'حماية الاختصار' },
                    { key: 'antiChannelDelete', icon: '🗑️', name: 'حماية الرومات' },
                    { key: 'antiChannelCreate', icon: '➕', name: 'منع الرومات الجديدة' },
                    { key: 'antiRoleDelete', icon: '🎭', name: 'حماية الرتب' },
                    { key: 'antiRoleCreate', icon: '✨', name: 'منع الرتب الجديدة' },
                    { key: 'antiBan', icon: '🔨', name: 'منع الحظر' },
                    { key: 'antiKick', icon: '👢', name: 'منع الطرد' },
                    { key: 'antiPrune', icon: '✂️', name: 'منع التنظيف' },
                    { key: 'antiEmojiDelete', icon: '😭', name: 'حماية الإيموجي' },
                    { key: 'antiEmojiCreate', icon: '😊', name: 'منع الإيموجي' },
                    { key: 'antiStickerDelete', icon: '🏷️', name: 'حماية الملصقات' },
                    { key: 'antiStickerCreate', icon: '📝', name: 'منع الملصقات' },
                    { key: 'antiIntegration', icon: '🔌', name: 'حماية التكاملات' },
                    { key: 'antiVanity', icon: '💫', name: 'حماية الرابط' },
                    { key: 'antiAlts', icon: '👶', name: 'منع الحسابات الوهمية' },
                    { key: 'antiToxic', icon: '☣️', name: 'منع الكلمات المسيئة' },
                    { key: 'antiCapslock', icon: '🔠', name: 'منع الأحرف الكبيرة' },
                    { key: 'antiMassMention', icon: '📢', name: 'منع المنشن الجماعي' },
                    { key: 'antiFlood', icon: '🌊', name: 'منع التكرار' },
                    { key: 'antiInvite', icon: '📩', name: 'منع الدعوات' },
                    { key: 'antiGhostPing', icon: '👻', name: 'منع الشبح' },
                    { key: 'antiMassBan', icon: '💥', name: 'منع الحظر الجماعي' },
                    { key: 'antiMassKick', icon: '🦵', name: 'منع الطرد الجماعي' },
                    { key: 'antiPermissionGuard', icon: '🔐', name: 'حراسة الصلاحيات' }
                ];
                const punishmentMap = { warn: 'تحذير', timeout: 'كتم', kick: 'طرد', ban: 'حظر', removeRoles: 'سحب رتب', mute: 'إسكات' };
                systems.forEach(sys => {
                    const enabled = settings[sys.key]?.enabled === true;
                %>
                <div class="system-item" data-system="<%= sys.key %>" onclick="selectSystem('<%= sys.key %>')">
                    <div class="sys-info">
                        <span class="icon"><%= sys.icon %></span>
                        <span class="name"><%= sys.name %></span>
                        <span class="badge <%= enabled ? 'enabled' : 'disabled' %>" id="badge_<%= sys.key %>"><%= enabled ? 'ON' : 'OFF' %></span>
                    </div>
                    <label class="toggle" onclick="event.stopPropagation()">
                        <input type="checkbox" <%= enabled ? 'checked' : '' %> onchange="toggleSystem('<%= sys.key %>', this.checked)" id="cb_<%= sys.key %>">
                        <span class="slider"></span>
                    </label>
                </div>
                <% }) %>
            </div>
        </div>

        <div class="main-panel">
            <div class="nav-bar">
                <a href="/" class="home-btn">🏠 الرئيسية</a>
                <span class="sep">/</span>
                <span class="current">🔧 <%= guild.name %></span>
                <div style="flex:1;"></div>
                <a href="<%= discordInvite %>" target="_blank" class="discord-btn-nav" onclick="showDiscordToast(event)">💬 الدعم الفني</a>
            </div>

            <div class="server-header-card">
                <div class="icon">
                    <% if (guild.icon) { %>
                        <img src="<%= guild.icon %>" alt="<%= guild.name %>">
                    <% } else { %>
                        <%= guild.name.charAt(0) %>
                    <% } %>
                </div>
                <div class="info">
                    <h1><%= guild.name %></h1>
                    <p>🆔 <%= guild.id %> • 👥 <%= guild.memberCount.toLocaleString() %> عضو</p>
                </div>
                <div class="quick-stats">
                    <div class="qs">
                        <div class="num" id="totalOn">0</div>
                        <div class="label">نشط</div>
                    </div>
                    <div class="qs">
                        <div class="num"><%= backup.channels.length %></div>
                        <div class="label">روم</div>
                    </div>
                    <div class="qs">
                        <div class="num"><%= backup.roles.length %></div>
                        <div class="label">رتبة</div>
                    </div>
                    <div class="qs">
                        <div class="num" id="totalLogs"><%= logs.length %></div>
                        <div class="label">حدث</div>
                    </div>
                </div>
            </div>

            <div class="section">
                <h2>⚡ إجراءات سريعة</h2>
                <div class="quick-actions">
                    <button class="btn-enable-all" onclick="toggleAll(true)">🔒 تفعيل الكل</button>
                    <button class="btn-disable-all" onclick="toggleAll(false)">🔓 إيقاف الكل</button>
                    <button class="btn-beast" onclick="showBeastModal()">👹 نظام الوحش</button>
                    <button class="btn-backup" onclick="createBackup()">💾 نسخ احتياطي</button>
                </div>
                <div id="beastInfo" style="display:none;margin-top:12px;padding:12px 16px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:10px;font-size:13px;color:#fca5a5;animation:fadeUp 0.4s;">
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <span>👹 <strong>نظام الوحش مفعل!</strong> - أي حركة تخريبية = حظر فوري 🚨</span>
                        <button onclick="stopBeastMode()" style="padding:6px 18px;background:rgba(239,68,68,0.2);border:1px solid rgba(239,68,68,0.3);border-radius:8px;color:#fca5a5;font-family:'Tajawal',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.3s;" onmouseover="this.style.background='rgba(239,68,68,0.3)'" onmouseout="this.style.background='rgba(239,68,68,0.2)'">⛔ إيقاف نظام الوحش</button>
                    </div>
                </div>
            </div>

            <div class="section">
                <h2>🛡️ الرتب المستثناة</h2>
                <p style="color:rgba(255,255,255,0.5);font-size:12px;margin:-8px 0 12px;line-height:1.6;">
                    الأعضاء في هذه الرتب ما راح يتأثرون بأي نظام حماية (يمنعون نهائياً)
                </p>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;" id="exemptRolesContainer">
                    <% const currentExempt = settings.exemptRoles || []; %>
                    <% currentExempt.forEach(rid => { const role = guildRoles.find(r => r.id === rid); if(role){ %>
                        <span class="exempt-role-tag" data-id="<%= role.id %>">
                            <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= role.color %>;margin-left:5px;"></span>
                            <%= role.name %>
                            <span class="remove-role" onclick="removeExemptRole('<%= role.id %>')" style="cursor:pointer;margin-right:6px;opacity:0.6;">✕</span>
                        </span>
                    <% }}); %>
                </div>
                <div style="display:flex;gap:8px;">
                    <select id="exemptRoleSelect" style="flex:1;padding:8px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);color:#fff;font-family:'Tajawal',sans-serif;font-size:13px;">
                        <option value="">-- اختر رتبة --</option>
                        <% guildRoles.filter(r => !currentExempt.includes(r.id)).forEach(r => { %>
                            <option value="<%= r.id %>" style="background:#1a1a2e;"><%= r.name %></option>
                        <% }); %>
                    </select>
                    <button onclick="addExemptRole()" style="padding:8px 20px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border:none;border-radius:8px;color:#fff;font-family:'Tajawal',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.3s;">➕ إضافة</button>
                </div>
            </div>

            <div id="settingsPanel">
                <div class="panel-header">
                    <h2 id="panelTitle">⚙️ الإعدادات</h2>
                    <button class="close-btn" onclick="closePanel()">✕</button>
                </div>
                <div id="panelContent"></div>
            </div>

            <div class="section" id="logsSection">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:15px;flex-wrap:wrap;gap:10px;">
                    <h2>📋 سجل الأحداث</h2>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <select id="logFilter" onchange="filterLogs()" style="padding:6px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);color:#fff;font-family:'Tajawal',sans-serif;font-size:12px;outline:none;">
                            <option value="all" style="background:#1a1a2e;">🔁 جميع الأنظمة</option>
                            <option value="antiRaid" style="background:#1a1a2e;">⚔️ منع الهجمات</option>
                            <option value="antiSpam" style="background:#1a1a2e;">📨 منع السبام</option>
                            <option value="antiLink" style="background:#1a1a2e;">🔗 منع الروابط</option>
                            <option value="antiBot" style="background:#1a1a2e;">🤖 منع البوتات</option>
                            <option value="antiSelfbot" style="background:#1a1a2e;">👤 منع السيلف بوت</option>
                            <option value="antiWebhook" style="background:#1a1a2e;">🪝 منع الويهوك</option>
                            <option value="antiNickname" style="background:#1a1a2e;">✏️ حماية الاختصار</option>
                            <option value="antiChannelDelete" style="background:#1a1a2e;">🗑️ حماية الرومات</option>
                            <option value="antiChannelCreate" style="background:#1a1a2e;">➕ منع الرومات</option>
                            <option value="antiRoleDelete" style="background:#1a1a2e;">🎭 حماية الرتب</option>
                            <option value="antiRoleCreate" style="background:#1a1a2e;">✨ منع الرتب</option>
                            <option value="antiBan" style="background:#1a1a2e;">🔨 منع الحظر</option>
                            <option value="antiKick" style="background:#1a1a2e;">👢 منع الطرد</option>
                            <option value="antiPrune" style="background:#1a1a2e;">✂️ منع التنظيف</option>
                            <option value="antiEmojiDelete" style="background:#1a1a2e;">😭 حماية الإيموجي</option>
                            <option value="antiEmojiCreate" style="background:#1a1a2e;">😊 منع الإيموجي</option>
                            <option value="antiStickerDelete" style="background:#1a1a2e;">🏷️ حماية الملصقات</option>
                            <option value="antiStickerCreate" style="background:#1a1a2e;">📝 منع الملصقات</option>
                            <option value="antiIntegration" style="background:#1a1a2e;">🔌 حماية التكاملات</option>
                            <option value="antiVanity" style="background:#1a1a2e;">💫 حماية الرابط</option>
                            <option value="antiAlts" style="background:#1a1a2e;">👶 منع الوهمية</option>
                            <option value="antiToxic" style="background:#1a1a2e;">☣️ منع المسيئة</option>
                            <option value="antiCapslock" style="background:#1a1a2e;">🔠 منع الكابس</option>
                            <option value="antiMassMention" style="background:#1a1a2e;">📢 منع المنشن</option>
                            <option value="antiFlood" style="background:#1a1a2e;">🌊 منع التكرار</option>
                            <option value="antiInvite" style="background:#1a1a2e;">📩 منع الدعوات</option>
                            <option value="antiGhostPing" style="background:#1a1a2e;">👻 منع الشبح</option>
                            <option value="antiMassBan" style="background:#1a1a2e;">💥 منع الحظر الجماعي</option>
                            <option value="antiMassKick" style="background:#1a1a2e;">🦵 منع الطرد الجماعي</option>
                            <option value="antiPermissionGuard" style="background:#1a1a2e;">🔐 حراسة الصلاحيات</option>
                            <option value="punishment" style="background:#1a1a2e;">🔨 عقوبات</option>
                            <option value="dashboard" style="background:#1a1a2e;">🌐 لوحة التحكم</option>
                        </select>
                        <span class="pill bg-blue" id="liveBadge" style="font-size:11px;">🔴 غير متصل</span>
                    </div>
                </div>
                <div class="logs-container" id="logsContainer">
                    <% if (logs.length === 0) { %>
                        <div class="no-logs" id="noLogsMsg">📭 لا توجد أحداث بعد</div>
                    <% } else { %>
                        <% logs.forEach(log => { %>
                            <div class="log-entry<%= log.type === 'punishment' ? ' log-punish' : '' %><%= (typeof log.action === 'object' && log.action.severity === 'danger') ? ' log-danger' : '' %>" data-type="<%= log.type %>">
                                <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                                    <% if (typeof log.action === 'object') { %>
                                        <span style="font-size:16px;"><%= log.action.icon || '📌' %></span>
                                        <div style="flex:1;min-width:0;">
                                            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                                <span style="font-weight:600;font-size:13px;"><%= log.action.userTag || 'System' %></span>
                                                <% if (log.action.severity === 'danger') { %>
                                                    <span class="pill bg-red">🚨 حظر</span>
                                                <% } else if (log.action.severity === 'warning') { %>
                                                    <span class="pill bg-yellow">⚠️ مخالفة</span>
                                                <% } else { %>
                                                    <span class="pill bg-blue">ℹ️ معلومات</span>
                                                <% } %>
                                            </div>
                                            <div style="font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;"><%= log.action.description %></div>
                                        </div>
                                    <% } else { %>
                                        <span style="font-size:16px;">📌</span>
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-size:13px;font-weight:500;"><%= log.action %></div>
                                            <% if (log.details && typeof log.details === 'object') { %>
                                                <div style="font-size:12px;color:rgba(255,255,255,0.5);"><%= JSON.stringify(log.details) %></div>
                                            <% } else if (log.details) { %>
                                                <div style="font-size:12px;color:rgba(255,255,255,0.5);"><%= log.details %></div>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                                <span class="log-time" style="white-space:nowrap;margin-right:8px;"><%= new Date(log.timestamp).toLocaleString('ar-SA') %></span>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        const settings = <%- JSON.stringify(settings) %>;
        const punishmentMap = <%- JSON.stringify(punishmentMap) %>;

        const systemConfigs = {
            antiRaid: { name: 'منع الهجمات الجماعية', icon: '⚔️', desc: 'يمنع دخول عدد كبير خلال وقت قصير', fields: [
