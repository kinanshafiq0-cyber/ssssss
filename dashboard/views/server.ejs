        }

        function filterLogs() {
            const filter = document.getElementById('logFilter').value;
            const entries = document.querySelectorAll('#logsContainer .log-entry');
            entries.forEach(el => {
                const type = el.dataset.type;
                el.style.display = (filter === 'all' || type === filter) ? 'flex' : 'none';
            });
            const visible = Array.from(entries).filter(e => e.style.display !== 'none').length;
            const noMsg = document.getElementById('noLogsMsg');
            if (noMsg) noMsg.style.display = visible > 0 ? 'none' : 'block';
        }

        function renderLogEntry(log) {
            const isStructured = typeof log.action === 'object' && log.action !== null;
            const icon = isStructured ? (log.action.icon || getLogIcon(log.type)) : getLogIcon(log.type);
            const userTag = isStructured ? (log.action.userTag || 'System') : 'System';
            const description = isStructured ? (log.action.description || '') : (log.details || log.action || '');
            const severity = isStructured ? (log.action.severity || 'info') : 'info';

            let severityBadge = '';
            if (severity === 'danger') severityBadge = '<span class="pill bg-red">🚨 حظر</span>';
            else if (severity === 'warning') severityBadge = '<span class="pill bg-yellow">⚠️ مخالفة</span>';
            else severityBadge = '<span class="pill bg-blue">ℹ️ معلومات</span>';

            const time = new Date(log.timestamp).toLocaleString('ar-SA');

            return `<div class="log-entry log-new${severity === 'danger' ? ' log-danger' : ''}${log.type === 'punishment' ? ' log-punish' : ''}" data-type="${log.type}">
                <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                    <span style="font-size:16px;">${icon}</span>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                            <span style="font-weight:600;font-size:13px;">${userTag}</span>
                            ${severityBadge}
                        </div>
                        <div style="font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;">${description}</div>
                    </div>
                </div>
                <span class="log-time" style="white-space:nowrap;margin-right:8px;">${time}</span>
            </div>`;
        }

        async function refreshLogs() {
            try {
                const res = await fetch('/api/server/<%= guild.id %>/logs');
                const data = await res.json();
                if (data.logs) {
                    const container = document.getElementById('logsContainer');
                    const filter = document.getElementById('logFilter').value;

                    if (data.logs.length > lastLogCount) {
                        const newLogs = data.logs.slice(0, data.logs.length - lastLogCount);
                        let newHtml = '';
                        newLogs.forEach(log => {
                            newHtml += renderLogEntry(log);
                        });
                        newHtml += container.innerHTML;
                        container.innerHTML = newHtml;

                        // Re-apply filter
                        const entries = container.querySelectorAll('.log-entry');
                        entries.forEach(el => {
                            const type = el.dataset.type;
                            if (filter !== 'all' && type !== filter) {
                                el.style.display = 'none';
                            }
                        });

                        lastLogCount = data.logs.length;
                        const totalLogs = document.getElementById('totalLogs');
                        if (totalLogs) totalLogs.textContent = data.logs.length;

                        // Remove animation class after animation
                        setTimeout(() => {
                            container.querySelectorAll('.log-new').forEach(el => el.classList.remove('log-new'));
                        }, 600);
                    }

                    updateLiveBadge(true);
                }
            } catch (e) {
                updateLiveBadge(false);
            }
        }

        function toggleLogs() {
            if (logRefreshInterval) {
                clearInterval(logRefreshInterval);
                logRefreshInterval = null;
                updateLiveBadge(false);
            } else {
                refreshLogs();
                logRefreshInterval = setInterval(refreshLogs, 4000);
                updateLiveBadge(true);
            }
        }

        // Start auto-refresh on page load
        document.addEventListener('DOMContentLoaded', () => {
            logRefreshInterval = setInterval(refreshLogs, 4000);
            updateLiveBadge(true);
        });

        // Live badge click to toggle
        document.getElementById('liveBadge')?.addEventListener('click', toggleLogs);

        function showDiscordToast(e) {
            e.preventDefault();
            const t = document.getElementById('discordToast');
            t.style.display = 'block';
            window.open(e.currentTarget.href, '_blank');
            setTimeout(() => t.style.display = 'none', 1200);
        }

        updateActiveCount();
    </script>
</body>
</html>
