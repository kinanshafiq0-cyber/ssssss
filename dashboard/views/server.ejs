<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام الحماية - <%= guild.name %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap');
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Tajawal', sans-serif;
            background: #0a0a12;
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
        }
        /* ===== ANIMATED BG ===== */
        .bg-particles {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 0; overflow: hidden;
        }
        .bg-particles span {
            position: absolute; display: block;
            width: 4px; height: 4px; border-radius: 50%;
            background: rgba(99,102,241,0.15);
            animation: floatUp linear infinite;
        }
        .bg-particles span:nth-child(1) { left: 10%; animation-duration: 12s; animation-delay: 0s; width: 6px; height: 6px; }
        .bg-particles span:nth-child(2) { left: 20%; animation-duration: 15s; animation-delay: 2s; background: rgba(168,85,247,0.12); }
        .bg-particles span:nth-child(3) { left: 30%; animation-duration: 10s; animation-delay: 4s; width: 8px; height: 8px; }
        .bg-particles span:nth-child(4) { left: 45%; animation-duration: 18s; animation-delay: 1s; background: rgba(236,72,153,0.1); }
        .bg-particles span:nth-child(5) { left: 55%; animation-duration: 13s; animation-delay: 3s; }
        .bg-particles span:nth-child(6) { left: 65%; animation-duration: 16s; animation-delay: 5s; width: 5px; height: 5px; background: rgba(99,102,241,0.1); }
        .bg-particles span:nth-child(7) { left: 75%; animation-duration: 11s; animation-delay: 0s; }
        .bg-particles span:nth-child(8) { left: 85%; animation-duration: 14s; animation-delay: 3s; width: 7px; height: 7px; background: rgba(168,85,247,0.15); }
        .bg-particles span:nth-child(9) { left: 90%; animation-duration: 17s; animation-delay: 2s; }
        .bg-particles span:nth-child(10) { left: 50%; animation-duration: 19s; animation-delay: 6s; background: rgba(236,72,153,0.08); }
        @keyframes floatUp {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-10vh) rotate(720deg); opacity: 0; }
        }

        .dashboard-wrapper { display: flex; flex-direction: row-reverse; min-height: 100vh; position: relative; z-index: 1; }
        .systems-sidebar {
            width: 340px; min-width: 340px;
            background: linear-gradient(180deg, rgba(15,12,41,0.95) 0%, rgba(26,26,46,0.95) 100%);
            backdrop-filter: blur(20px);
            border-left: 1px solid rgba(255,255,255,0.06);
            padding: 20px; overflow-y: auto; height: 100vh; position: sticky; top: 0;
        }
        .systems-sidebar .sidebar-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 20px; padding-bottom: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .systems-sidebar .sidebar-header .logo-shield {
            display: flex; align-items: center; gap: 10px;
        }
        .systems-sidebar .sidebar-header .logo-shield .shield-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            font-size: 18px; animation: glowPulse 3s ease-in-out infinite;
        }
        @keyframes glowPulse {
            0%, 100% { box-shadow: 0 0 10px rgba(99,102,241,0.3); }
            50% { box-shadow: 0 0 25px rgba(99,102,241,0.6), 0 0 40px rgba(168,85,247,0.3); }
        }
        .systems-sidebar .sidebar-header .logo-shield h3 { font-size: 15px; font-weight: 700; }
        .systems-sidebar .sidebar-header .count {
            font-size: 11px; color: rgba(255,255,255,0.4);
            background: rgba(255,255,255,0.06); padding: 4px 10px; border-radius: 20px;
        }
        #searchSystem {
            width: 100%; padding: 10px 14px; margin-bottom: 12px;
            background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px; color: #fff; font-family: 'Tajawal', sans-serif; font-size: 13px;
            outline: none; transition: all 0.3s;
        }
        #searchSystem:focus { border-color: rgba(99,102,241,0.5); box-shadow: 0 0 20px rgba(99,102,241,0.1); }
        #searchSystem::placeholder { color: rgba(255,255,255,0.3); }
        .system-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 12px; border-radius: 10px; margin-bottom: 2px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer;
            border: 1px solid transparent; position: relative; overflow: hidden;
        }
        .system-item::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(99,102,241,0.05), transparent);
            transform: translateX(-100%); transition: transform 0.6s;
        }
        .system-item:hover::before { transform: translateX(100%); }
        .system-item:hover { background: rgba(255,255,255,0.04); transform: translateX(-4px); }
        .system-item.active {
            background: rgba(99,102,241,0.15); border-color: rgba(99,102,241,0.3);
            box-shadow: 0 0 20px rgba(99,102,241,0.1);
            transform: translateX(-4px);
        }
        .system-item .sys-info { display: flex; align-items: center; gap: 10px; }
        .system-item .sys-info .icon { font-size: 16px; transition: transform 0.3s; }
        .system-item:hover .sys-info .icon { transform: scale(1.2); }
        .system-item .sys-info .name { font-size: 13px; font-weight: 500; }
        .system-item .sys-info .badge {
            font-size: 10px; padding: 2px 8px; border-radius: 10px;
            transition: all 0.3s;
        }
        .system-item .sys-info .badge.enabled { background: rgba(34,197,94,0.2); color: #4ade80; }
        .system-item .sys-info .badge.disabled { background: rgba(239,68,68,0.15); color: #f87171; }
        .toggle {
            position: relative; width: 44px; height: 24px; cursor: pointer;
        }
        .toggle input { opacity: 0; width: 0; height: 0; }
        .toggle .slider {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(255,255,255,0.1); border-radius: 12px; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .toggle .slider::before {
            content: ''; position: absolute; width: 18px; height: 18px;
            border-radius: 50%; background: #fff; top: 3px; right: 3px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .toggle input:checked + .slider { background: linear-gradient(135deg, #6366f1, #a855f7); box-shadow: 0 0 15px rgba(99,102,241,0.3); }
        .toggle input:checked + .slider::before { transform: translateX(-20px); }

        .main-panel { flex: 1; padding: 30px; overflow-y: auto; }

        .server-header-card {
            background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(168,85,247,0.12));
            border: 1px solid rgba(255,255,255,0.06); border-radius: 20px;
            padding: 30px; margin-bottom: 25px;
            display: flex; align-items: center; gap: 25px;
            position: relative; overflow: hidden;
            animation: slideDown 0.6s ease-out;
        }
        .server-header-card::after {
            content: ''; position: absolute; top: -50%; right: -20%;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(99,102,241,0.08), transparent 70%);
            animation: rotateGlow 8s linear infinite;
        }
        @keyframes rotateGlow {
            0% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(180deg) scale(1.2); }
            100% { transform: rotate(360deg) scale(1); }
        }
        @keyframes slideDown {
            0% { opacity: 0; transform: translateY(-30px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .server-header-card .icon {
            width: 80px; height: 80px; border-radius: 16px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            display: flex; align-items: center; justify-content: center;
            font-size: 32px; font-weight: 700; object-fit: cover;
            position: relative; z-index: 1;
        }
        .server-header-card .icon img { width: 100%; height: 100%; border-radius: 16px; object-fit: cover; }
        .server-header-card .info { position: relative; z-index: 1; }
        .server-header-card .info h1 { font-size: 24px; font-weight: 900; }
        .server-header-card .info p { color: rgba(255,255,255,0.5); font-size: 14px; }
        .server-header-card .quick-stats { display: flex; gap: 20px; margin-right: auto; position: relative; z-index: 1; }
        .server-header-card .quick-stats .qs {
            text-align: center; background: rgba(255,255,255,0.04);
            padding: 10px 20px; border-radius: 12px;
            transition: all 0.3s; cursor: default;
        }
        .server-header-card .quick-stats .qs:hover { background: rgba(255,255,255,0.08); transform: translateY(-2px); }
        .server-header-card .quick-stats .qs .num { font-size: 20px; font-weight: 900; color: #6366f1; }
        .server-header-card .quick-stats .qs .label { font-size: 11px; color: rgba(255,255,255,0.4); }

        .section {
            background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px; padding: 20px; margin-bottom: 20px;
            animation: fadeUp 0.5s ease-out;
        }
        @keyframes fadeUp {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .section h2 {
            font-size: 16px; font-weight: 700; margin-bottom: 15px;
            display: flex; align-items: center; gap: 8px;
        }
        .section .quick-actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .section .quick-actions button {
            padding: 10px 20px; border: none; border-radius: 10px;
            font-family: 'Tajawal', sans-serif; font-size: 13px; font-weight: 600;
            cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative; overflow: hidden;
        }
        .section .quick-actions button::after {
            content: ''; position: absolute; top: 50%; left: 50%;
            width: 0; height: 0; border-radius: 50%;
            background: rgba(255,255,255,0.2);
            transition: width 0.6s, height 0.6s, top 0.6s, left 0.6s;
        }
        .section .quick-actions button:active::after {
            width: 300px; height: 300px; top: -100px; left: -100px;
        }
        .btn-enable-all { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; }
        .btn-enable-all:hover { box-shadow: 0 5px 20px rgba(34,197,94,0.3); transform: translateY(-2px); }
        .btn-disable-all { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
        .btn-disable-all:hover { box-shadow: 0 5px 20px rgba(239,68,68,0.3); transform: translateY(-2px); }
        .btn-beast {
            background: linear-gradient(135deg, #dc2626, #7c3aed);
            color: #fff; animation: beastPulse 2s ease-in-out infinite;
        }
        .btn-beast:hover { box-shadow: 0 5px 25px rgba(220,38,38,0.5); transform: translateY(-2px); }
        @keyframes beastPulse {
            0%, 100% { box-shadow: 0 0 10px rgba(220,38,38,0.3); }
            50% { box-shadow: 0 0 25px rgba(220,38,38,0.6), 0 0 50px rgba(124,58,237,0.3); }
        }
        .btn-backup { background: linear-gradient(135deg, #6366f1, #a855f7); color: #fff; }
        .btn-backup:hover { box-shadow: 0 5px 20px rgba(99,102,241,0.3); transform: translateY(-2px); }

        #settingsPanel {
            display: none;
            background: rgba(255,255,255,0.02); border: 1px solid rgba(99,102,241,0.2);
            border-radius: 16px; padding: 25px; margin-bottom: 20px;
            animation: fadeUp 0.4s ease-out;
        }
        #settingsPanel.visible { display: block; }
        #settingsPanel .panel-header {
            display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
        }
        #settingsPanel .panel-header h2 { font-size: 18px; font-weight: 700; }
        #settingsPanel .panel-header .close-btn {
            background: rgba(239,68,68,0.15); border: none; color: #f87171;
            width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 16px;
            transition: all 0.3s;
        }
        #settingsPanel .panel-header .close-btn:hover { background: rgba(239,68,68,0.3); transform: rotate(90deg); }

        .setting-group {
            background: rgba(255,255,255,0.03); border-radius: 12px;
            padding: 16px; margin-bottom: 12px;
            transition: all 0.3s;
        }
        .setting-group:hover { background: rgba(255,255,255,0.05); }
        .setting-group label {
            display: block; font-size: 13px; font-weight: 500;
            color: rgba(255,255,255,0.7); margin-bottom: 6px;
        }
        .setting-group .desc {
            font-size: 11px; color: rgba(255,255,255,0.3); margin-bottom: 8px;
        }
        .setting-group input, .setting-group select {
            width: 100%; padding: 10px 14px;
            background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px; color: #fff;
            font-family: 'Tajawal', sans-serif; font-size: 13px; outline: none;
            transition: all 0.3s;
        }
        .setting-group select option { background: #1a1a2e; color: #fff; }
        .setting-group input:focus, .setting-group select:focus {
            border-color: rgba(99,102,241,0.5); background: rgba(255,255,255,0.08);
            box-shadow: 0 0 20px rgba(99,102,241,0.1);
        }
        .setting-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .btn-save {
            width: 100%; padding: 12px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border: none; border-radius: 10px; color: #fff;
            font-family: 'Tajawal', sans-serif; font-size: 14px; font-weight: 700;
            cursor: pointer; transition: all 0.4s; margin-top: 10px;
        }
        .btn-save:hover { box-shadow: 0 5px 20px rgba(99,102,241,0.4); transform: translateY(-2px); }

        .exempt-role-tag {
            display:inline-flex; align-items:center; gap:4px;
            padding:5px 10px; border-radius:8px; font-size:12px; font-weight:500;
            background:rgba(99,102,241,0.12); border:1px solid rgba(99,102,241,0.2);
            transition:all 0.3s; animation: fadeUp 0.3s;
        }
        .exempt-role-tag:hover { background:rgba(99,102,241,0.2); }
        .exempt-role-tag .remove-role:hover { opacity:1 !important; color:#f87171; }

        .logs-container { max-height: 250px; overflow-y: auto; }
        .log-entry {
            padding: 8px 12px; border-radius: 8px; margin-bottom: 4px;
            font-size: 12px; background: rgba(255,255,255,0.02);
            display: flex; justify-content: space-between; align-items: center;
            transition: all 0.3s;
        }
        .log-entry:hover { background: rgba(255,255,255,0.05); }
        .log-entry .log-time { color: rgba(255,255,255,0.3); font-size: 11px; }
        .log-entry .log-action { color: #6366f1; font-weight: 500; }
        .log-entry.log-punish { border-right: 3px solid #ef4444; }
        .log-entry.log-danger { border-right: 3px solid #dc2626; background: rgba(220,38,38,0.06); }
        .no-logs { color: rgba(255,255,255,0.3); font-size: 13px; text-align: center; padding: 20px; }
        .live-active { animation: livePulse 2s ease-in-out infinite !important; color: #4ade80 !important; }
        @keyframes livePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .log-new {
            animation: logSlideIn 0.5s ease-out;
        }
        @keyframes logSlideIn {
            0% { opacity: 0; transform: translateX(-20px); }
            100% { opacity: 1; transform: translateX(0); }
        }

        /* ===== CUSTOM MODAL ===== */
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);
            z-index: 99999; align-items: center; justify-content: center;
            animation: fadeIn 0.3s;
        }
        .modal-overlay.show { display: flex; }
        @keyframes fadeIn {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }
        .modal-box {
            background: linear-gradient(135deg, #1a1a2e, #0f0c29);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px; padding: 35px; width: 480px; max-width: 90%;
            box-shadow: 0 30px 80px rgba(0,0,0,0.5);
            animation: modalPop 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative; overflow: hidden;
        }
        .modal-box::before {
            content: ''; position: absolute; top: -2px; left: -2px; right: -2px; bottom: -2px;
            background: linear-gradient(45deg, rgba(99,102,241,0.3), rgba(168,85,247,0.3), rgba(236,72,153,0.3));
            border-radius: 25px; z-index: -1; opacity: 0.5; filter: blur(8px);
        }
        @keyframes modalPop {
            0% { opacity: 0; transform: scale(0.8) translateY(20px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-box .modal-icon { font-size: 50px; text-align: center; margin-bottom: 15px; }
        .modal-box .modal-icon.warning { animation: shakeIcon 0.5s; }
        @keyframes shakeIcon {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-10deg); }
            75% { transform: rotate(10deg); }
        }
        .modal-box h2 { font-size: 20px; font-weight: 900; text-align: center; margin-bottom: 8px; }
        .modal-box p { color: rgba(255,255,255,0.6); font-size: 14px; text-align: center; margin-bottom: 10px; line-height: 1.8; }
        .modal-box .modal-details {
            background: rgba(255,255,255,0.03); border-radius: 12px;
            padding: 15px; margin: 15px 0; font-size: 13px; line-height: 2;
            max-height: 200px; overflow-y: auto;
        }
        .modal-box .modal-details div { display: flex; justify-content: space-between; }
        .modal-box .modal-details .danger { color: #f87171; }
        .modal-box .modal-details .medium { color: #facc15; }
        .modal-box .modal-details .safe { color: #4ade80; }
        .modal-box .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
        .modal-box .modal-actions button {
            flex: 1; padding: 12px; border: none; border-radius: 12px;
            font-family: 'Tajawal', sans-serif; font-size: 14px; font-weight: 700;
            cursor: pointer; transition: all 0.3s;
        }
        .modal-box .modal-actions .btn-confirm {
            background: linear-gradient(135deg, #dc2626, #7c3aed); color: #fff;
        }
        .modal-box .modal-actions .btn-confirm:hover { box-shadow: 0 5px 20px rgba(220,38,38,0.4); transform: translateY(-2px); }
        .modal-box .modal-actions .btn-cancel {
            background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);
        }
        .modal-box .modal-actions .btn-cancel:hover { background: rgba(255,255,255,0.1); }

        .toast {
            position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
            background: rgba(34,197,94,0.9); backdrop-filter: blur(10px);
            color: #fff; padding: 14px 28px;
            border-radius: 14px; font-family: 'Tajawal', sans-serif; font-size: 14px;
            z-index: 999999; display: none; box-shadow: 0 10px 40px rgba(34,197,94,0.3);
            animation: toastIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .toast.error { background: rgba(239,68,68,0.9); box-shadow: 0 10px 40px rgba(239,68,68,0.3); }
        .toast.beast { background: linear-gradient(135deg, #dc2626, #7c3aed); box-shadow: 0 10px 40px rgba(220,38,38,0.4); }
        @keyframes toastIn {
            0% { opacity: 0; transform: translateX(-50%) translateY(30px) scale(0.9); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
        }
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
        .pill { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; margin-left: 6px; }
        .pill.bg-green { background: rgba(34,197,94,0.2); color: #4ade80; }
        .pill.bg-red { background: rgba(239,68,68,0.15); color: #f87171; }
        .pill.bg-yellow { background: rgba(234,179,8,0.15); color: #facc15; }
        .pill.bg-blue { background: rgba(99,102,241,0.15); color: #818cf8; }

        .nav-bar {
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 20px; font-size: 14px;
        }
        .nav-bar a {
            color: rgba(255,255,255,0.4); text-decoration: none;
            transition: all 0.3s;
        }
        .nav-bar a:hover { color: #6366f1; }
        .nav-bar .sep { color: rgba(255,255,255,0.2); }
        .nav-bar .current { color: rgba(255,255,255,0.8); font-weight: 500; }
        .nav-bar .home-btn {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 14px; background: rgba(255,255,255,0.04);
            border-radius: 8px; font-size: 13px;
        }
        .nav-bar .home-btn:hover { background: rgba(99,102,241,0.15); color: #818cf8; }
        .nav-bar .discord-btn-nav {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 14px; background: rgba(88,101,242,0.12);
            border-radius: 8px; font-size: 13px; color: #8b9cf7;
            text-decoration: none; transition: all 0.3s;
        }
        .nav-bar .discord-btn-nav:hover { background: rgba(88,101,242,0.25); color: #a5b4fc; }
        .toast-discord {
            position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
            background: rgba(88,101,242,0.95); backdrop-filter: blur(10px);
            color: #fff; padding: 14px 28px;
            border-radius: 14px; font-family: 'Tajawal', sans-serif; font-size: 14px;
            z-index: 999999; display: none; box-shadow: 0 10px 40px rgba(88,101,242,0.3);
            animation: toastIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
</head>
<body>
