        function showToast(msg, type) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'toast' + (type ? ' ' + type : '');
            t.style.display = 'block';
            setTimeout(() => t.style.display = 'none', 3500);
        }

        function updateActiveCount() {
            const checkboxes = document.querySelectorAll('#systemsList input[type="checkbox"]');
            const active = Array.from(checkboxes).filter(c => c.checked).length;
            document.getElementById('activeCount').textContent = active + '/30';
            const totalOn = document.getElementById('totalOn');
            if (totalOn) totalOn.textContent = active;
            checkboxes.forEach(cb => {
                const sys = cb.closest('.system-item').dataset.system;
                const badge = document.getElementById('badge_' + sys);
                if (badge) {
                    badge.textContent = cb.checked ? 'ON' : 'OFF';
                    badge.className = 'badge ' + (cb.checked ? 'enabled' : 'disabled');
                }
            });
        }

        function filterSystems(val) {
            const items = document.querySelectorAll('.system-item');
            const q = val.toLowerCase();
            items.forEach(item => {
                const name = item.querySelector('.name').textContent.toLowerCase();
                item.style.display = name.includes(q) ? 'flex' : 'none';
            });
        }

        function selectSystem(key) {
            document.querySelectorAll('.system-item').forEach(el => el.classList.remove('active'));
            const el = document.querySelector(`.system-item[data-system="${key}"]`);
            if (el) el.classList.add('active');
            showSettings(key);
        }

        function closePanel() {
            document.getElementById('settingsPanel').classList.remove('visible');
            document.querySelectorAll('.system-item').forEach(el => el.classList.remove('active'));
        }

        function showSettings(key) {
            const cfg = systemConfigs[key];
            if (!cfg) return;
            const sysSettings = settings[key] || {};
            const panel = document.getElementById('settingsPanel');
            const title = document.getElementById('panelTitle');
            const content = document.getElementById('panelContent');

            title.textContent = cfg.icon + ' ' + cfg.name;
            let html = `<p style="color:rgba(255,255,255,0.5);font-size:13px;margin-bottom:16px;">${cfg.desc}</p>`;

            if (cfg.fields.length === 0) {
                html += `<p style="color:rgba(255,255,255,0.4);text-align:center;padding:20px;">✅ هذا النظام لا يحتاج إعدادات</p>`;
            } else {
                cfg.fields.forEach(f => {
                    const val = sysSettings[f.key] !== undefined ? sysSettings[f.key] : '';
                    html += `<div class="setting-group"><label>${f.label}</label>`;
                    if (f.desc) html += `<div class="desc">${f.desc}</div>`;
                    if (f.type === 'select') {
                        html += `<select id="field_${f.key}">`;
                        for (const [vk, vn] of Object.entries(punishmentMap)) {
                            html += `<option value="${vk}" ${(sysSettings[f.key] || 'timeout') === vk ? 'selected' : ''}>${vn}</option>`;
                        }
                        html += `</select>`;
                    } else {
                        html += `<input type="${f.type}" id="field_${f.key}" value="${val}" placeholder="${f.label}">`;
                    }
                    html += `</div>`;
                });
                html += `<button class="btn-save" onclick="saveSettings('${key}')">💾 حفظ الإعدادات</button>`;
            }
            content.innerHTML = html;
            panel.classList.add('visible');
        }

        async function saveSettings(key) {
            const cfg = systemConfigs[key];
            const data = {};
            cfg.fields.forEach(f => {
                const el = document.getElementById('field_' + f.key);
                if (el) {
                    if (f.type === 'number') data[f.key] = parseFloat(el.value) || 0;
                    else data[f.key] = el.value;
                }
            });
            try {
                const res = await fetch('/api/server/<%= guild.id %>/setting', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ system: key, settings: data })
                });
                const d = await res.json();
                if (d.success) showToast(`✅ حفظ إعدادات ${cfg.name}`);
                else showToast('❌ فشل الحفظ', 'error');
            } catch (e) { showToast('❌ حدث خطأ', 'error'); }
        }

        // ===== MODAL SYSTEM =====
        let modalCallback = null;

        function showModal(icon, title, desc, details, confirmText, callback) {
            document.getElementById('modalIcon').textContent = icon;
            document.getElementById('modalIcon').className = 'modal-icon warning';
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalDesc').textContent = desc;
            const detailsEl = document.getElementById('modalDetails');
            if (details) {
                detailsEl.innerHTML = details;
                detailsEl.style.display = 'block';
            } else {
                detailsEl.style.display = 'none';
            }
            document.getElementById('modalConfirm').textContent = confirmText || 'تأكيد';
            modalCallback = callback;
            document.getElementById('modalOverlay').classList.add('show');
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('show');
            modalCallback = null;
        }

        document.getElementById('modalConfirm').addEventListener('click', () => {
            if (modalCallback) modalCallback();
            closeModal();
        });

