        // ===== EXEMPT ROLES =====
        async function addExemptRole() {
            const select = document.getElementById('exemptRoleSelect');
            const roleId = select.value;
            if (!roleId) return showToast('❌ اختر رتبة أولاً', 'error');
            const container = document.getElementById('exemptRolesContainer');
            // Get current exempt role IDs from tags
            const currentIds = Array.from(container.querySelectorAll('.exempt-role-tag')).map(el => el.dataset.id);
            if (currentIds.includes(roleId)) return showToast('⚠️ الرتبة موجودة مسبقاً', 'error');

            // Find the role name from the select options
            const option = select.querySelector(`option[value="${roleId}"]`);
            const roleName = option ? option.textContent : roleId;

            // Optimistic update
            const role = <%- JSON.stringify(guildRoles.reduce((acc, r) => { acc[r.id] = r; return acc; }, {})) %>;
            const r = role[roleId];
            const tag = document.createElement('span');
            tag.className = 'exempt-role-tag';
            tag.dataset.id = roleId;
            tag.innerHTML = `<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${r?.color || '#6366f1'};margin-left:5px;"></span> ${r?.name || roleName} <span class="remove-role" onclick="removeExemptRole('${roleId}')" style="cursor:pointer;margin-right:6px;opacity:0.6;">✕</span>`;
            container.appendChild(tag);
            select.remove(select.selectedIndex);
            select.value = '';

            // Save to server
            const newIds = currentIds.concat(roleId);
            try {
                const res = await fetch('/api/server/<%= guild.id %>/exempt-roles', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roles: newIds })
                });
                const data = await res.json();
                if (!data.success) throw new Error('API error');
                showToast(`✅ تمت إضافة ${r?.name || roleName} للرتب المستثناة`);
            } catch (e) {
                tag.remove();
                // Re-add option
                const opt = document.createElement('option');
                opt.value = roleId;
                opt.textContent = roleName;
                opt.style.background = '#1a1a2e';
                select.appendChild(opt);
                showToast('❌ فشل حفظ الرتب المستثناة', 'error');
            }
        }

        async function removeExemptRole(roleId) {
            const container = document.getElementById('exemptRolesContainer');
            const currentIds = Array.from(container.querySelectorAll('.exempt-role-tag')).map(el => el.dataset.id);

            const tag = container.querySelector(`.exempt-role-tag[data-id="${roleId}"]`);
            if (!tag) return;
            const roleName = tag.textContent.replace('✕', '').trim();

            // Optimistic
            tag.style.opacity = '0.3';
            const newIds = currentIds.filter(id => id !== roleId);

            try {
                const res = await fetch('/api/server/<%= guild.id %>/exempt-roles', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roles: newIds })
                });
                const data = await res.json();
                if (!data.success) throw new Error('API error');
                tag.remove();
                // Re-add to select
                const select = document.getElementById('exemptRoleSelect');
                const opt = document.createElement('option');
                opt.value = roleId;
                opt.textContent = roleName;
                opt.style.background = '#1a1a2e';
                select.appendChild(opt);
                showToast(`✅ تمت إزالة ${roleName} من الرتب المستثناة`);
            } catch (e) {
                tag.style.opacity = '1';
                showToast('❌ فشل إزالة الرتبة', 'error');
            }
        }

