<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم - نظام حماية السيرفرات</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap');
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Tajawal', sans-serif;
            background: #0a0a12;
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ===== ANIMATED BG ===== */
        .bg-grid {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image:
                linear-gradient(rgba(99,102,241,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(99,102,241,0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 25s linear infinite;
        }
        @keyframes gridMove {
            0% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0); }
        }

        .orb {
            position: fixed; border-radius: 50%; filter: blur(100px); pointer-events: none; z-index: 0;
        }
        .orb-1 { width: 600px; height: 600px; background: radial-gradient(circle, rgba(99,102,241,0.1), transparent); top: -20%; left: -20%; animation: orbA 15s ease-in-out infinite; }
        .orb-2 { width: 450px; height: 450px; background: radial-gradient(circle, rgba(168,85,247,0.08), transparent); bottom: -20%; right: -20%; animation: orbB 18s ease-in-out infinite; }
        @keyframes orbA {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(60px, 40px) scale(1.1); }
        }
        @keyframes orbB {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-50px, -30px) scale(1.15); }
        }

        .page-wrapper { position: relative; z-index: 1; max-width: 1400px; margin: 0 auto; padding: 30px; }

        /* ===== TOP BAR ===== */
        .top-bar {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 35px;
            animation: slideDown 0.6s ease-out;
        }
        @keyframes slideDown {
            0% { opacity: 0; transform: translateY(-30px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .top-bar .brand { display: flex; align-items: center; gap: 14px; }
        .top-bar .brand .shield {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border-radius: 14px; display: flex; align-items: center; justify-content: center;
            font-size: 26px; animation: glowPulse 3s ease-in-out infinite;
        }
        @keyframes glowPulse {
            0%, 100% { box-shadow: 0 0 15px rgba(99,102,241,0.3); }
            50% { box-shadow: 0 0 30px rgba(99,102,241,0.5), 0 0 50px rgba(168,85,247,0.2); }
        }
        .top-bar .brand .text h1 { font-size: 22px; font-weight: 900; }
        .top-bar .brand .text p { font-size: 12px; color: rgba(255,255,255,0.4); }

        .top-bar .user-area {
            display: flex; align-items: center; gap: 15px;
        }
        .top-bar .user-area .username {
            font-size: 14px; color: rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.03);
            padding: 8px 16px; border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.04);
        }
        .top-bar .user-area .logout-btn {
            padding: 10px 22px;
            background: rgba(239,68,68,0.08);
            border: 1px solid rgba(239,68,68,0.12);
            border-radius: 12px;
            color: #f87171;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex; align-items: center; gap: 8px;
            position: relative; overflow: hidden;
        }
        .top-bar .user-area .logout-btn::before {
            content: '';
            position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(239,68,68,0.1), transparent);
            transition: left 0.6s;
        }
        .top-bar .user-area .logout-btn:hover::before { left: 100%; }
        .top-bar .user-area .logout-btn:hover {
            background: rgba(239,68,68,0.15);
            border-color: rgba(239,68,68,0.3);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239,68,68,0.15);
        }
        .top-bar .user-area .logout-btn:active { transform: translateY(0); }
        .top-bar .user-area .discord-btn {
            padding: 10px 22px;
            background: rgba(88,101,242,0.15);
            border: 1px solid rgba(88,101,242,0.25);
            border-radius: 12px;
            color: #8b9cf7;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex; align-items: center; gap: 8px;
        }
        .top-bar .user-area .discord-btn:hover {
            background: rgba(88,101,242,0.25);
            border-color: rgba(88,101,242,0.4);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(88,101,242,0.2);
        }
        .top-bar .user-area .discord-btn:active { transform: translateY(0); }

        /* ===== STATS ===== */
        .stats-row {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px; margin-bottom: 35px;
        }
        .stat-card {
            background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px; padding: 20px;
            display: flex; align-items: center; gap: 16px;
            transition: all 0.4s; cursor: default;
            animation: slideUp 0.6s ease-out; backdrop-filter: blur(10px);
        }
        .stat-card:nth-child(2) { animation-delay: 0.1s; }
        .stat-card:nth-child(3) { animation-delay: 0.2s; }
        .stat-card:nth-child(4) { animation-delay: 0.3s; }
        @keyframes slideUp {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .stat-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(99,102,241,0.2); transform: translateY(-3px) scale(1.02); }
        .stat-card .stat-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; font-size: 22px;
            transition: transform 0.4s;
        }
        .stat-card:hover .stat-icon { transform: scale(1.1) rotate(-5deg); }
        .stat-card .stat-icon.purple { background: rgba(99,102,241,0.15); }
        .stat-card .stat-icon.green { background: rgba(34,197,94,0.15); }
        .stat-card .stat-icon.blue { background: rgba(59,130,246,0.15); }
        .stat-card .stat-icon.orange { background: rgba(234,179,8,0.15); }
        .stat-card .stat-info .num { font-size: 26px; font-weight: 900; letter-spacing: 1px; }
        .stat-card .stat-info .num.purple { color: #818cf8; }
        .stat-card .stat-info .num.green { color: #4ade80; }
        .stat-card .stat-info .num.blue { color: #60a5fa; }
        .stat-card .stat-info .num.orange { color: #facc15; }
        .stat-card .stat-info .label { font-size: 12px; color: rgba(255,255,255,0.4); }

        .section-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 20px; animation: fadeIn 0.8s ease-out;
        }
        @keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }
        .section-header h2 { font-size: 20px; font-weight: 700; }
        .section-header .badge-count {
            font-size: 13px; color: rgba(255,255,255,0.4);
            background: rgba(255,255,255,0.05); padding: 6px 14px; border-radius: 20px;
        }

        .servers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 18px;
        }
        .server-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 18px;
            padding: 22px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            animation: fadeCards 0.6s ease-out;
            backdrop-filter: blur(10px);
        }
        @keyframes fadeCards {
            0% { opacity: 0; transform: translateY(30px) scale(0.95); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        .server-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, transparent, rgba(99,102,241,0.03));
            opacity: 0; transition: opacity 0.4s;
        }
        .server-card:hover {
            background: rgba(255,255,255,0.04);
            border-color: rgba(99,102,241,0.25);
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }
        .server-card:hover::before { opacity: 1; }
        .server-card .card-header {
            display: flex; align-items: center; gap: 15px;
            margin-bottom: 15px; position: relative; z-index: 1;
        }
        .server-card .card-header .icon {
            width: 50px; height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; color: #fff; font-weight: 700;
            object-fit: cover; transition: transform 0.4s;
        }
        .server-card:hover .card-header .icon { transform: scale(1.05) rotate(-3deg); }
        .server-card .card-header .icon img {
            width: 100%; height: 100%;
            border-radius: 12px;
            object-fit: cover;
        }
        .server-card .card-header .info { flex: 1; }
        .server-card .card-header .info h3 { font-size: 16px; font-weight: 700; transition: color 0.3s; }
        .server-card:hover .card-header .info h3 { color: #818cf8; }
        .server-card .card-header .info p { font-size: 12px; color: rgba(255,255,255,0.4); }
        .server-card .card-footer {
            display: flex; justify-content: space-between; align-items: center;
            position: relative; z-index: 1;
        }
        .server-card .card-footer .badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
        }
        .server-card .card-footer .badge.on { background: rgba(34,197,94,0.15); color: #4ade80; }
        .server-card .card-footer .badge.off { background: rgba(239,68,68,0.12); color: #f87171; }
        .server-card .card-footer .badge.partial { background: rgba(234,179,8,0.12); color: #facc15; }
        .server-card .card-footer .enter-btn {
            padding: 6px 16px; border-radius: 8px;
            background: rgba(99,102,241,0.1); color: #818cf8;
            font-size: 12px; font-weight: 500; transition: all 0.3s;
        }
        .server-card:hover .card-footer .enter-btn { background: rgba(99,102,241,0.2); transform: translateX(-4px); }

        .empty-state {
            text-align: center; padding: 80px 20px;
            color: rgba(255,255,255,0.4); grid-column: 1 / -1;
            animation: fadeIn 1s ease-out;
        }
        .empty-state .big-icon { font-size: 70px; margin-bottom: 20px; opacity: 0.6; animation: floatIcon 4s ease-in-out infinite; }
        @keyframes floatIcon {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .empty-state h2 { font-size: 22px; margin-bottom: 10px; color: rgba(255,255,255,0.6); }
        .empty-state p { font-size: 14px; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }

        .toast-discord {
            position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
            background: rgba(88,101,242,0.95); backdrop-filter: blur(10px);
            color: #fff; padding: 14px 28px;
            border-radius: 14px; font-family: 'Tajawal', sans-serif; font-size: 14px;
            z-index: 999999; display: none; box-shadow: 0 10px 40px rgba(88,101,242,0.3);
            animation: toastIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        @keyframes toastIn {
            0% { opacity: 0; transform: translateX(-50%) translateY(30px) scale(0.9); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
        }
        @media (max-width: 600px) {
            .top-bar { flex-direction: column; gap: 15px; align-items: stretch; }
            .top-bar .user-area { justify-content: flex-end; }
            .stats-row { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>
    <div class="toast-discord" id="discordToast">💬 يتم تحويلك إلى سيرفر الدعم...</div>
    <div class="bg-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="page-wrapper">
        <div class="top-bar">
            <div class="brand">
                <div class="shield">🛡️</div>
                <div class="text">
                    <h1>نظام الحماية</h1>
                    <p>لوحة التحكم الرئيسية</p>
                </div>
            </div>
            <div class="user-area">
                <span class="username">👤 <%= username %></span>
                <a href="<%= discordInvite %>" target="_blank" class="discord-btn" onclick="showDiscordToast(event)">💬 ديسكورد</a>
                <a href="/logout" class="logout-btn">🚪 تسجيل الخروج</a>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon purple">📡</div>
                <div class="stat-info">
                    <div class="num purple"><%= totalServers %></div>
                    <div class="label">السيرفرات</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">🟢</div>
                <div class="stat-info">
                    <div class="num green" id="totalActiveStats">0</div>
                    <div class="label">أنظمة نشطة</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon blue">⚡</div>
                <div class="stat-info">
                    <div class="num blue">30</div>
                    <div class="label">نظام حماية</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">🛡️</div>
                <div class="stat-info">
                    <div class="num orange">v3.0</div>
                    <div class="label">الإصدار</div>
                </div>
            </div>
        </div>

        <div class="section-header">
            <h2>📂 السيرفرات</h2>
            <span class="badge-count"><%= totalServers %> سيرفر</span>
        </div>

        <div class="servers-grid">
            <% if (servers.length === 0) { %>
                <div class="empty-state">
                    <div class="big-icon">🤖</div>
                    <h2>لا يوجد سيرفرات</h2>
                    <p>حط البوت في سيرفر عشان يظهر هنا</p>
                </div>
            <% } else { %>
                <% servers.forEach(server => { %>
                    <% 
                        const s = server.protectionStatus || {};
                        const enabledCount = Object.values(s).filter(x => x.enabled === true).length;
                        const totalCount = Object.keys(s).length;
                        let badgeClass = 'off';
                        let badgeText = 'غير مفعل';
                        if (enabledCount === totalCount) { badgeClass = 'on'; badgeText = 'مفعل كلياً'; }
                        else if (enabledCount > 0) { badgeClass = 'partial'; badgeText = `مفعل جزئياً`; }
                    %>
                    <div class="server-card" onclick="window.location.href='/server/<%= server.id %>'">
                        <div class="card-header">
                            <div class="icon">
                                <% if (server.icon) { %>
                                    <img src="<%= server.icon %>" alt="<%= server.name %>">
                                <% } else { %>
                                    <%= server.name.charAt(0) %>
                                <% } %>
                            </div>
                            <div class="info">
                                <h3><%= server.name %></h3>
                                <p>👥 <%= server.memberCount.toLocaleString() %> عضو • 🆔 <%= server.id %></p>
                            </div>
                        </div>
                        <div class="card-footer">
                            <span class="badge <%= badgeClass %>"><%= badgeText %> (<%= enabledCount %>/<%= totalCount %>)</span>
                            <span class="enter-btn">الدخول ←</span>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <script>
        function showDiscordToast(e) {
            e.preventDefault();
            const t = document.getElementById('discordToast');
            t.style.display = 'block';
            window.open(e.currentTarget.href, '_blank');
            setTimeout(() => t.style.display = 'none', 1200);
        }

        let totalActive = 0;
        <%
        servers.forEach(server => {
            const s = server.protectionStatus || {};
            const count = Object.values(s).filter(x => x.enabled === true).length;
        %>
        totalActive += <%= count %>;
        <% }); %>
        document.getElementById('totalActiveStats').textContent = totalActive;

        // Animate numbers on load
        document.querySelectorAll('.num').forEach(el => {
            const target = parseInt(el.textContent);
            if (isNaN(target) || target === 0) return;
            let current = 0;
            const step = Math.max(1, Math.floor(target / 30));
            const interval = setInterval(() => {
                current += step;
                if (current >= target) {
                    current = target;
                    clearInterval(interval);
                }
                el.textContent = current;
            }, 30);
        });
    </script>
</body>
</html>
